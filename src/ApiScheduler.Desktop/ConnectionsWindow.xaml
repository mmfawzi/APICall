<Window x:Class="ApiScheduler.Desktop.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database connections" Height="520" Width="820" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                    <Button Content="+ New" Click="New_Click"/>
                    <Button Content="Delete" Click="Delete_Click" Margin="0"/>
                </StackPanel>
                <ListBox x:Name="List" DisplayMemberPath="Name" SelectionChanged="List_SelectionChanged" BorderThickness="0" Margin="4"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="16">
            <Grid x:Name="Form" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Grid.Column="1"/>

                <TextBlock Grid.Row="1" Text="Server" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Grid.Row="2" Text="Database" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DatabaseBox" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Grid.Row="3" Text="Authentication" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AuthBox" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="AuthBox_SelectionChanged">
                    <ComboBoxItem Content="Windows" Tag="Windows"/>
                    <ComboBoxItem Content="SQL Server" Tag="Sql"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Text="SQL user" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="5" Text="SQL password" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="5" Grid.Column="1">
                    <PasswordBox x:Name="PasswordBox" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Text="Encryption" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="6" Grid.Column="1">
                    <CheckBox x:Name="EncryptBox" Content="Encrypt connection (TLS) — recommended"/>
                    <CheckBox x:Name="TrustBox" Content="Trust server certificate (only for self-signed SQL certificates)"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Windows authentication: the SERVICE connects as its service account; this app (Preview/Test) connects as you. Both need access. Grant the service account only SELECT and UPDATE on the tables it uses."/>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="300" TextWrapping="Wrap"/>
                    <Button Content="Test connection" Click="Test_Click"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
