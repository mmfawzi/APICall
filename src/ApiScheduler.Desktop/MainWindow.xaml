<Window x:Class="ApiScheduler.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ApiScheduler.Desktop.ViewModels"
        Title="API Scheduler" Height="820" Width="1280" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Panel}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Top bar: service status -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Run Text="Service:"/> <Run Text="{Binding ServiceStatus, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Button Content="Start" Command="{Binding StartServiceCommand}" IsEnabled="{Binding ServiceInstalled}"/>
                    <Button Content="Stop" Command="{Binding StopServiceCommand}" IsEnabled="{Binding ServiceRunning}"/>
                    <Button Content="Connections…" Command="{Binding ManageConnectionsCommand}"/>
                    <Button Content="Reload" Command="{Binding ReloadFromDiskCommand}" Margin="0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="API Scheduler" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#D6E4F5" FontSize="11">
                        <Run Text="Data folder:"/> <Run Text="{Binding DataFolder, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}"/>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Job list -->
            <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="API jobs" Style="{StaticResource SectionTitle}" Margin="12,10,12,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10">
                        <Button Content="+ New job" Command="{Binding NewJobCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                        <Button Content="+ New from Survey SMS template" Command="{Binding NewSurveyJobCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                        <Button Content="Delete selected" Command="{Binding DeleteJobCommand}" Margin="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" BorderThickness="0" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="Select a job on the left, or create a new one."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel DataContext="{Binding Editor}" x:Name="EditorPanel">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <Trigger Property="DataContext" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Editor header -->
                        <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="Run now" Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="0"
                                            Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Foreground="#C0392B" FontSize="12">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="Text" Value="  • unsaved"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                        <Run Text="Next run:"/> <Run Text="{Binding NextRun, Mode=OneWay}"/>
                                        <Run Text="   |   Last run:"/> <Run Text="{Binding LastResult, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TabControl Margin="10" BorderBrush="{StaticResource Border}">
                            <!-- ============ GENERAL ============ -->
                            <TabItem Header="General">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="16" MaxWidth="820" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Job name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1" Text="Enabled" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Enabled}" Content="Run this job on its schedule"/>

                                        <TextBlock Grid.Row="2" Text="API URL (POST)" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="HTTPS is required. Redirects are not followed, so the key is never sent anywhere else."/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Text="API key header name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApiKeyHeaderName, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="4" Text="API key" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remove key" Command="{Binding ClearApiKeyCommand}" Margin="6,0,0,8"/>
                                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding ApiKeyStatus}"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Leave empty to keep the stored key. The key is encrypted with Windows DPAPI (machine-bound) and never shown again."/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Text="Pinned cert thumbprint" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Row="5" Grid.Column="1">
                                            <TextBox Text="{Binding PinnedCertificateThumbprint, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Optional. Only if the API uses an internal certificate the server doesn't trust. Accepts exactly that certificate; validation is never disabled."/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Text="Schedule — every (hours)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding IntervalHours, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="7" Text="Schedule — starting at" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Row="7" Grid.Column="1">
                                            <TextBox Text="{Binding ScheduleAnchor, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="HH:mm, server local time. 00:00 with 8 hours → runs at 00:00, 08:00, 16:00. Leave empty for 'interval after last run'."/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="8" Text="Request timeout (sec)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="9" Text="Delay between calls (ms)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding DelayBetweenCallsMs, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="10" Text="Max rows per run" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MaxRowsPerRun, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ============ QUERY & BODY ============ -->
                            <TabItem Header="Query &amp; JSON body">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="Connection" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" Width="280" HorizontalAlignment="Left"/>
                                        <TextBlock Text="  SELECT query (one statement, read-only):" VerticalAlignment="Center" Margin="12,0,0,8" Foreground="{StaticResource Muted}"/>
                                    </DockPanel>
                                    <TextBox Grid.Row="1" Text="{Binding SelectQuery, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                             FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                                        <Button Content="Validate" Command="{Binding ValidateQueryCommand}"/>
                                        <Button Content="Run preview" Command="{Binding PreviewCommand}"/>
                                        <Button Content="Auto-map columns" Command="{Binding AutoMapCommand}"/>
                                        <TextBlock Text="Working…" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="{Binding QueryMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Content="+ Field" Command="{Binding AddMappingCommand}" MinWidth="0"/>
                                                    <Button Content="Remove" Command="{Binding RemoveMappingCommand}" MinWidth="0"/>
                                                    <Button Content="▲" Command="{Binding MoveMappingUpCommand}" MinWidth="0"/>
                                                    <Button Content="▼" Command="{Binding MoveMappingDownCommand}" MinWidth="0" Margin="0"/>
                                                </StackPanel>
                                                <TextBlock Text="JSON body mapping" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" CanUserAddRows="False"
                                                      CellEditEnding="Mappings_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="JSON field" Binding="{Binding JsonField, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                                    <DataGridComboBoxColumn Header="Source" SelectedItemBinding="{Binding Source}" Width="80"
                                                                            ItemsSource="{x:Static vm:JobEditorViewModel.SourceValues}"/>
                                                    <DataGridTextColumn Header="Column / fixed value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                    <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="80"
                                                                            ItemsSource="{x:Static vm:JobEditorViewModel.TypeValues}"/>
                                                    <DataGridTextColumn Header="If NULL use" Binding="{Binding DefaultIfNull, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                        <DockPanel Grid.Column="2">
                                            <TextBlock DockPanel.Dock="Top" Text="JSON preview (first row)" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                            <TextBox Text="{Binding PreviewJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                     VerticalContentAlignment="Top" TextWrapping="NoWrap" Margin="0"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFBFC"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- ============ PREVIEW ROWS ============ -->
                            <TabItem Header="Preview rows">
                                <DockPanel Margin="12">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                               Text="First 20 rows returned by the query (click 'Run preview' on the Query tab). These rows are what the next run would send."/>
                                    <DataGrid ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="True" IsReadOnly="True"/>
                                </DockPanel>
                            </TabItem>

                            <!-- ============ WRITE-BACK ============ -->
                            <TabItem Header="Mark as sent">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="16" MaxWidth="820" HorizontalAlignment="Left" Binding.SourceUpdated="WriteBack_Changed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{StaticResource Muted}"
                                                   Text="After each row is POSTed, the row is updated so it is never sent twice. On success: SENT_CALL = success value and SENT_DATE = GETDATE(). On failure SENT_DATE stays NULL (so it retries next run) and SENT_CALL = FAILED-xxx (server/network error) or REJECTED-xxx (4xx — bad data; excluded by the template query)."/>

                                        <TextBlock Grid.Row="1" Text="Enabled" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding WriteBack.Enabled, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Content="Update the source row after each call"/>

                                        <TextBlock Grid.Row="2" Text="Table" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WriteBack.TableName, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>

                                        <TextBlock Grid.Row="3" Text="Key column" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WriteBack.KeyColumn, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>

                                        <TextBlock Grid.Row="4" Text="Sent-call column" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WriteBack.SentCallColumn, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>

                                        <TextBlock Grid.Row="5" Text="Sent-date column" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WriteBack.SentDateColumn, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>

                                        <TextBlock Grid.Row="6" Text="Success value" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WriteBack.SuccessValue, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="200" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="7" Text="Record failures" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding WriteBack.WriteFailureStatus, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                                  Content="Write FAILED-xxx / REJECTED-xxx into the sent-call column"/>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ============ HISTORY ============ -->
                            <TabItem Header="Run history">
                                <DockPanel Margin="12">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Refresh" Command="{Binding LoadHistoryCommand}"/>
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Text="Per-row details are in the log files under the data folder\logs."/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartLocal, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                                            <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="80"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                                            <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="60"/>
                                            <DataGridTextColumn Header="Sent" Binding="{Binding Succeeded}" Width="60"/>
                                            <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="60"/>
                                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
